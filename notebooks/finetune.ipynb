   "source": [
    "# Setup the trainer for fine-tuning\n",
    "# NOTE: A proper implementation would pass the full datasets (including labels) to the trainer.\n",
    "# Here we pass the encoders and the trainer will handle label preparation.\n",
    "trainer, checkpoint_manager = setup_finetuning(\n",
    "    model, train_dataloader, val_dataloader, config, device, user_tag_encoder, collection_label_encoder\n",
    ")\n",
    "\n",
    "# The trainer needs access to the full data to create batches with labels. We patch it here.\n",
    "# In a real library, the DataLoader would handle this.\n",
    "trainer.train_dataloader.dataset.full_data = list(zip(train_data, train_difficulty, train_labels, train_tags))\n",
    "trainer.val_dataloader.dataset.full_data = list(zip(val_data, val_difficulty, val_labels, val_tags))\n",
    "\n",
    "start_epoch = 0\n",
    "if checkpoint_manager.checkpoint_exists():\n",
    "    try:\n",
    "        start_epoch, metrics = checkpoint_manager.load_checkpoint(\n",
    "            model, trainer.optimizer, trainer.scheduler, trainer.scaler, device=device\n",
    "        )\n",
    "        start_epoch += 1 \n",
    "        print(f\"Loaded fine-tuning checkpoint, resuming from epoch {start_epoch + 1}\")\n",
    "    except Exception as e:\n",
    "        print(f\"Could not load fine-tuning checkpoint: {e}. Starting from scratch.\")\n",
    "\n",
    "print(f\"Fine-tuning setup complete. Starting from epoch {start_epoch + 1}.\")"
   ]
