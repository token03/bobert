   "id": "q7r8s9t0",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Split all data consistently\n",
    "val_split_ratio = config['data']['val_split']\n",
    "num_samples = len(all_beatmaps_data)\n",
    "indices = torch.randperm(num_samples).tolist()\n",
    "split_idx = int(num_samples * (1 - val_split_ratio))\n",
    "\n",
    "train_indices, val_indices = indices[:split_idx], indices[split_idx:]\n",
    "\n",
    "train_data = [all_beatmaps_data[i] for i in train_indices]\n",
    "val_data = [all_beatmaps_data[i] for i in val_indices]\n",
    "train_difficulty = difficulty_ratings[train_indices]\n",
    "val_difficulty = difficulty_ratings[val_indices]\n",
    "train_labels = [all_labels[i] for i in train_indices]\n",
    "val_labels = [all_labels[i] for i in val_indices]\n",
    "train_tags = [all_tags[i] for i in train_indices]\n",
    "val_tags = [all_tags[i] for i in val_indices]\n",
    "\n",
    "print(f\"Data split: {len(train_data)} training, {len(val_data)} validation\")\n",
    "\n",
    "# Create sampler and normalizer based on the training set ONLY\n",
    "sampler = create_kde_sampler(\n",
    "    train_difficulty,\n",
    "    bandwidth=config['training']['sampling']['kde_bandwidth']\n",
    ")\n",
    "\n",
    "normalizer = calculate_normalization_stats(train_data)\n",
    "print(\"Normalization stats calculated from training data.\")"
   ]
  },
