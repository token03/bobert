   "id": "m3n4o5p6",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Create encoders for categorical labels (collections and tags)\n",
    "def create_encoder(labels_list, min_freq=5):\n",
    "    all_labels = list(itertools.chain.from_iterable(labels_list))\n",
    "    counts = Counter(all_labels)\n",
    "    vocab = sorted([label for label, count in counts.items() if count >= min_freq])\n",
    "    encoder = {label: i for i, label in enumerate(vocab)}\n",
    "    return encoder\n",
    "\n",
    "collection_label_encoder = create_encoder(all_labels, min_freq=config['contrastive'].get('collection_min_freq', 5))\n",
    "user_tag_encoder = create_encoder(all_tags, min_freq=config['contrastive'].get('tag_min_freq', 10))\n",
    "\n",
    "print(f\"Created collection label encoder with {len(collection_label_encoder)} classes.\")\n",
    "print(f\"Created user tag encoder with {len(user_tag_encoder)} classes.\")\n",
    "\n",
    "# Update config with the actual number of classes\n",
    "config['contrastive']['collection_label_classes'] = len(collection_label_encoder)\n",
    "config['contrastive']['user_tag_classes'] = len(user_tag_encoder)\n",
    "\n",
    "# Save encoders for later use\n",
    "os.makedirs('./data', exist_ok=True)\n",
    "with open('./data/collection_encoder.json', 'w') as f:\n",
    "    json.dump(collection_label_encoder, f)\n",
    "with open('./data/user_tag_encoder.json', 'w') as f:\n",
    "    json.dump(user_tag_encoder, f)"
   ]
  },
    {
   "cell_type": "code",
