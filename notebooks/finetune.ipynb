   "source": [
    "model = BertForContrastiveFineTuning.from_config(config, device)\n",
    "print(\"Initialized BertForContrastiveFineTuning model.\")\n",
    "\n",
    "# Load weights from pre-trained model\n",
    "pretrain_checkpoint_dir = config['training']['checkpoint_dir']\n",
    "pretrain_model_name = config['model'].get('type', 'model')\n",
    "pretrain_manager = CheckpointManager(pretrain_checkpoint_dir, pretrain_model_name)\n",
    "\n",
    "if pretrain_manager.checkpoint_exists():\n",
    "    print(\"Found pre-trained checkpoint. Loading BERT encoder weights...\")\n",
    "    checkpoint = torch.load(pretrain_manager.get_checkpoint_path(), map_location=device)\n",
    "    pretrain_state_dict = checkpoint['model_state_dict']\n",
    "    \n",
    "    # Filter for weights belonging to the base BERT model\n",
    "    bert_state_dict = {k.replace('bert.', ''): v for k, v in pretrain_state_dict.items() if k.startswith('bert.')}\n",
    "    \n",
    "    missing, unexpected = model.bert.load_state_dict(bert_state_dict, strict=False)\n",
    "    print(f\"Loaded weights into model.bert. Missing keys: {len(missing)}, Unexpected keys: {len(unexpected)}\")\n",
    "    # Freeze the base model if configured\n",
    "    if config['contrastive'].get('freeze_base_model', False):\n",
    "        for param in model.bert.parameters():\n",
    "            param.requires_grad = False\n",
    "        print(\"Froze parameters of the base BERT model.\")\n",
    "else:\n",
    "    print(\"WARNING: No pre-trained checkpoint found. Training from scratch.\")\n",
    "\n",
    "print(\"\\nModel Summary:\")\n",
    "summary = model.get_summary()\n",
    "print(f\"  - Total Parameters: {summary['total_parameters']:,}\")\n",
    "print(f\"  - Trainable Parameters: {summary['trainable_parameters']:,}\")"
   ]
