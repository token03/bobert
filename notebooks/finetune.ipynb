    "    tags_path=config['data']['tags_path']\n",
    ")\n",
    "\n",
    "print_data_summary(all_beatmaps_data)\n",
    "print(f\"Loaded {len(all_labels)} sets of collection labels.\")\n",
    "print(f\"Loaded {len(all_tags)} sets of user tags.\")"
   ]
  },
  {
   "cell_type": "code",
