{
  "name": "bobert-gateway",
  "main": "src/worker.js",
  "workers_dev": false,
  "preview_urls": false,
  "compatibility_date": "2026-08-23",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "vpc_services": [
    {
      "binding": "API",
      "service_id": "01a02bea-0271-7eb1-9f36-48f6c24c8237"
    }
  ],
 "ratelimits": [
    {
      "name": "RECOMMEND_BURST",
      "namespace_id": "41001",
      "simple": {
        "limit": 20,
        "period": 10
      }
    },
    {
      "name": "RECOMMEND_SUSTAINED",
      "namespace_id": "41002",
      "simple": {
        "limit": 90,
        "period": 60
      }
    }
  ]
}
